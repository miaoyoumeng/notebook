{
  "context": {
    "includeFiles": ["src/**/*.ts", "src/**/*.vue"],
    "excludeFiles": ["node_modules/**", "dist/**"]
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Git",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(git *)",
      "Bash(pnpm *)",
      "Bash(uv run python *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf ~/)",
      "Bash(rm -r *)",
      "Bash(rm -r ~/)",
      "Bash(sudo *)",
      "Bash(scp *)",
      "Bash(eval *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(pnpm publish *)",
      "Bash(npm *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "SessionStart": [
      
    ],
    "PreCompact": [
      
    ],
    "SessionEnd": [
      
    ]
  },
  "enabledPlugins": {
    "nodejs@miaoyoumeng": true
  }
}
